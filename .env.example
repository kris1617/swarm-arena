# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Drizzle
DATABASE_URL="file:./db.sqlite"

# Auth (NextAuth / Auth.js)
# Generate AUTH_SECRET with: npx auth secret
# Register a GitHub OAuth app at https://github.com/settings/developers to get AUTH_GITHUB_ID/AUTH_GITHUB_SECRET
AUTH_SECRET="changeme"
AUTH_GITHUB_ID="changeme"
AUTH_GITHUB_SECRET="changeme"
ADMIN_EMAILS=""
# Without this, next-auth rejects every session with "UntrustedHost" unless
# AUTH_URL is set — needed for `next start` against localhost, and for the
# real deploy behind its reverse proxy.
AUTH_TRUST_HOST="true"

# E2E test-only auth bypass (see src/app/api/test-auth/login/route.ts).
# Leave unset in every deployed environment. Only matters for local
# `npx playwright test` runs, never for `npm run dev`/`build`.
E2E_TEST_AUTH_SECRET=""
